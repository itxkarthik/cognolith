# Store text files with LF in the repo and check them out with LF on every OS
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree
*.ps1 text eol=crlf

# Binary files: never convert or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.zip binary
*.pyc binary
*.woff binary
*.woff2 binary
